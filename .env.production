# MAVT Production Environment

# Comma-separated list of app bundle IDs to track
MAVT_APPS=com.apple.mobilesafari,com.apple.Music

# Production check interval
MAVT_CHECK_INTERVAL=1h

# App Store country/region
MAVT_COUNTRY=AU

# Info logging for production
MAVT_LOG_LEVEL=info

# Data directory
MAVT_DATA_DIR=/app/data

# HTTP server settings
MAVT_SERVER_HOST=0.0.0.0
MAVT_SERVER_PORT=8080

# Apprise notification URL (optional)
# MAVT_APPRISE_URL=
