# MAVT Staging Environment

# Comma-separated list of app bundle IDs to track (test apps)
MAVT_APPS=com.apple.mobilesafari

# Shorter interval for testing
MAVT_CHECK_INTERVAL=15m

# App Store country/region
MAVT_COUNTRY=AU

# Debug logging for troubleshooting
MAVT_LOG_LEVEL=debug

# Data directory
MAVT_DATA_DIR=/app/data

# HTTP server settings
MAVT_SERVER_HOST=0.0.0.0
MAVT_SERVER_PORT=8080

# Apprise notification URL (optional - use test channel)
# MAVT_APPRISE_URL=
